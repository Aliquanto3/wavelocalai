# ==========================================
# WAVELOCALAI - CONFIGURATION ENVIRONNEMENT
# ==========================================
# Modèle du fichier .env : copiez-le (cp .env.example .env), puis remplissez
# seulement ce dont vous avez besoin. Toutes les variables sont facultatives.
# Ne committez JAMAIS le fichier .env.
#
# Ollama : l'application vise l'instance locale sur 127.0.0.1:11434 ; l'adresse
# n'est pas configurable dans la v1.

# ==========================================
# MESURE CARBONE (CODECARBON)
# ==========================================
# Code ISO du pays pour l'intensité carbone de l'électricité (défaut : FRA).
# Exemples : FRA (France), DEU (Allemagne), USA (États-Unis).
# WAVELOCAL_COUNTRY_ISO=FRA

# PUE (Power Usage Effectiveness) appliqué à la mesure (défaut : 1.1).
# 1.0 = poste local sans datacenter, 1.2 à 1.5 = datacenter moderne.
# WAVELOCAL_PUE=1.1

# ==========================================
# MODÈLES CLOUD (facultatif)
# ==========================================
# Utilisés seulement quand « Autoriser le cloud » est activé dans l'application :
# les données envoyées à ces modèles quittent la machine.

# Mistral AI (https://console.mistral.ai/)
# MISTRAL_API_KEY=

# OpenAI (https://platform.openai.com/)
# OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=

# Groq (https://console.groq.com/keys) : offre gratuite, API compatible OpenAI.
# Modèles proposés : openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile,
# llama-3.1-8b-instant. Quota dépassé (429) : erreur affichée.
# GROQ_API_KEY=

# ==========================================
# OUTIL EMAIL DES AGENTS (facultatif)
# ==========================================
# Sans ces variables, l'outil email reste indisponible. Activé, l'agent prépare le
# message et un humain valide avant l'envoi.
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ==========================================
# TÉLÉMÉTRIE DES LIBRAIRIES
# ==========================================
# Coupée par défaut (src/core/telemetry.py, liste reprise dans le README). Pour la
# réactiver, définissez ici la variable concernée : la valeur du .env l'emporte.
# Exemple : ANONYMIZED_TELEMETRY=True
