{
  "id": "agent-seul-email-suite",
  "kind": "agent",
  "label": "Agent seul : suite après la décision sur l'email (approved, rejected ou expired)",
  "_doc": "Rejoué par l'écran sur le même run, après approval_resolved. vars : tag, decision, result_text, is_refusal, answer, metrics, email_to, email_subject, email_body, tps.",
  "events": [
    {
      "wait": 0,
      "type": "approval_resolved",
      "data": {
        "approval_id": "apr-0001",
        "decision": "{{decision}}"
      }
    },
    {
      "wait": 300,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s4",
        "agent": "agent",
        "kind": "tool_result",
        "tool": "envoi_email",
        "arguments": {
          "to": "{{email_to}}",
          "subject": "{{email_subject}}",
          "body": "{{email_body}}"
        },
        "summary": "{{result_text}}",
        "artifact_url": null,
        "duration_s": "{{approval_s}}",
        "outcome": "{{result_text}}"
      }
    },
    {
      "wait": 150,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s5",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 800,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s5",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": "{{reflection}}",
        "artifact_url": null,
        "duration_s": 0.8
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s6",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 150,
      "tokens": {
        "lane": "{{tag}}",
        "channel": "answer",
        "text": "{{answer}}",
        "tps": "{{tps}}"
      }
    },
    {
      "wait": 100,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s6",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": "Réponse finale rédigée à partir des résultats des outils.",
        "artifact_url": null,
        "duration_s": 3.6
      }
    },
    {
      "wait": 120,
      "type": "metrics",
      "data": "{{metrics}}"
    },
    {
      "wait": 40,
      "type": "run_ended",
      "data": {
        "status": "ok",
        "error": null
      }
    }
  ]
}
