{
  "id": "agent-seul-poste",
  "kind": "agent",
  "label": "Agent seul : lit l'état du poste (trois étapes)",
  "events": [
    {
      "wait": 0,
      "type": "run_started",
      "data": {
        "kind": "agent",
        "models": [
          "{{tag}}"
        ],
        "params": {
          "mode": "solo",
          "tools": "{{tools}}"
        }
      }
    },
    {
      "wait": 150,
      "when": "{{loading}}",
      "type": "model_loading",
      "data": {
        "tag": "{{tag}}"
      }
    },
    {
      "wait": 3200,
      "slow_wait": 14000,
      "when": "{{loading}}",
      "type": "model_loaded",
      "data": {
        "tag": "{{tag}}",
        "duration_s": "{{load_s}}"
      }
    },
    {
      "wait": 250,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s1",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 700,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s1",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": "Je lis la charge et la mémoire avec le moniteur système.",
        "artifact_url": null,
        "duration_s": 0.7
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s2",
        "agent": "agent",
        "kind": "tool_call",
        "tool": "moniteur_systeme",
        "arguments": {},
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 900,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s2",
        "agent": "agent",
        "kind": "tool_result",
        "tool": "moniteur_systeme",
        "arguments": {},
        "summary": "Processeur 14 %, mémoire 9,8 Go sur 16 Go, un modèle chargé.",
        "artifact_url": null,
        "duration_s": 0.9
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s3",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 150,
      "tokens": {
        "lane": "{{tag}}",
        "channel": "answer",
        "text": "{{answer}}",
        "tps": "{{tps}}"
      }
    },
    {
      "wait": 100,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s3",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": "Réponse finale rédigée à partir des résultats des outils.",
        "artifact_url": null,
        "duration_s": 3.2
      }
    },
    {
      "wait": 120,
      "type": "metrics",
      "data": "{{metrics}}"
    },
    {
      "wait": 40,
      "type": "run_ended",
      "data": {
        "status": "ok",
        "error": null
      }
    }
  ]
}
