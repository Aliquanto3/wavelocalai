{
  "id": "discussion-reponse",
  "kind": "rag",
  "label": "Question aux documents : recherche (selon la stratégie), sources avant le premier token, réponse, citations vérifiées, métriques",
  "_doc": "vars : tag, strategy, plain (une seule recherche, sans réponse hypothétique), hyde, self_rag, rerank (bool), top_k, sources, loading, load_s, thought_on, thought, answer, has_citations, citations, tps, metrics. `retrieval_step` annonce l'étape qui commence (la durée de recherche arrive dans `metrics.search_s`) ; `sources` part avant le premier `token` (story 4.4).",
  "events": [
    { "wait": 0, "type": "run_started", "data": { "kind": "rag", "models": ["{{tag}}"], "params": { "strategy": "{{strategy}}", "top_k": "{{top_k}}" } } },
    { "wait": 80, "when": "{{hyde}}", "type": "retrieval_step", "data": { "strategy": "{{strategy}}", "step": "hypothetical" } },
    { "wait": 80, "when": "{{plain}}", "type": "retrieval_step", "data": { "strategy": "{{strategy}}", "step": "search" } },
    { "wait": 1800, "when": "{{hyde}}", "type": "retrieval_step", "data": { "strategy": "{{strategy}}", "step": "search" } },
    { "wait": 700, "when": "{{self_rag}}", "type": "retrieval_step", "data": { "strategy": "{{strategy}}", "step": "verify" } },
    { "wait": 700, "when": "{{rerank}}", "type": "retrieval_step", "data": { "strategy": "{{strategy}}", "step": "rerank" } },
    { "wait": 800, "type": "sources", "data": { "sources": "{{sources}}" } },
    { "wait": 150, "when": "{{loading}}", "type": "model_loading", "data": { "tag": "{{tag}}" } },
    { "wait": 3200, "slow_wait": 14000, "when": "{{loading}}", "type": "model_loaded", "data": { "tag": "{{tag}}", "duration_s": "{{load_s}}" } },
    { "wait": 400, "when": "{{thought_on}}", "tokens": { "lane": "{{tag}}", "channel": "thought", "text": "{{thought}}", "tps": "{{tps}}" } },
    { "wait": 250, "tokens": { "lane": "{{tag}}", "channel": "answer", "text": "{{answer}}", "tps": "{{tps}}" } },
    { "wait": 150, "when": "{{has_citations}}", "type": "citations", "data": { "citations": "{{citations}}" } },
    { "wait": 120, "type": "metrics", "data": "{{metrics}}" },
    { "wait": 40, "type": "run_ended", "data": { "status": "ok", "error": null } }
  ]
}
