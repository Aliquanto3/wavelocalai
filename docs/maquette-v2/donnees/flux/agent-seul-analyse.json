{
  "id": "agent-seul-analyse",
  "kind": "agent",
  "label": "Agent seul : lit ventes.csv, trace un graphique, répond (quatre étapes)",
  "_doc": "vars : tag, tools, loading, load_s, tps, answer, metrics. Chaque étape : un événement de début (duration_s nul), un événement de fin pour le même step_id (duration_s renseigné).",
  "events": [
    {
      "wait": 0,
      "type": "run_started",
      "data": {
        "kind": "agent",
        "models": [
          "{{tag}}"
        ],
        "params": {
          "mode": "solo",
          "tools": "{{tools}}"
        }
      }
    },
    {
      "wait": 150,
      "when": "{{loading}}",
      "type": "model_loading",
      "data": {
        "tag": "{{tag}}"
      }
    },
    {
      "wait": 3200,
      "slow_wait": 14000,
      "when": "{{loading}}",
      "type": "model_loaded",
      "data": {
        "tag": "{{tag}}",
        "duration_s": "{{load_s}}"
      }
    },
    {
      "wait": 250,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s1",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 900,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s1",
        "agent": "agent",
        "kind": "think",
        "tool": null,
        "arguments": null,
        "summary": "Je lis d'abord ventes.csv pour connaître ses colonnes, puis je calcule le chiffre d'affaires par mois et je trace un graphique.",
        "artifact_url": null,
        "duration_s": 0.9
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s2",
        "agent": "agent",
        "kind": "tool_call",
        "tool": "analyse_donnees",
        "arguments": {
          "file": "ventes.csv",
          "operation": "résumé"
        },
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 2100,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s2",
        "agent": "agent",
        "kind": "tool_result",
        "tool": "analyse_donnees",
        "arguments": {
          "file": "ventes.csv",
          "operation": "résumé"
        },
        "summary": "12 lignes, 4 colonnes (mois, produit, quantité, chiffre_affaires). Total : 482 300 €. Mois le plus fort : novembre (51 200 €).",
        "artifact_url": null,
        "duration_s": 2.1
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s3",
        "agent": "agent",
        "kind": "tool_call",
        "tool": "generation_graphique",
        "arguments": {
          "file": "ventes.csv",
          "type": "barres",
          "x": "mois",
          "y": "chiffre_affaires",
          "title": "Chiffre d'affaires par mois"
        },
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 1400,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s3",
        "agent": "agent",
        "kind": "tool_result",
        "tool": "generation_graphique",
        "arguments": {
          "file": "ventes.csv",
          "type": "barres",
          "x": "mois",
          "y": "chiffre_affaires",
          "title": "Chiffre d'affaires par mois"
        },
        "summary": "Graphique enregistré : ventes_par_mois.svg (12 barres).",
        "artifact_url": "/api/outputs/ventes_par_mois.svg",
        "duration_s": 1.4
      }
    },
    {
      "wait": 200,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s4",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": null,
        "artifact_url": null,
        "duration_s": null
      }
    },
    {
      "wait": 150,
      "tokens": {
        "lane": "{{tag}}",
        "channel": "answer",
        "text": "{{answer}}",
        "tps": "{{tps}}"
      }
    },
    {
      "wait": 100,
      "type": "step",
      "data": {
        "lane": "{{tag}}",
        "step_id": "s4",
        "agent": "agent",
        "kind": "answer",
        "tool": null,
        "arguments": null,
        "summary": "Réponse finale rédigée à partir des résultats des outils.",
        "artifact_url": null,
        "duration_s": 5.4
      }
    },
    {
      "wait": 120,
      "type": "metrics",
      "data": "{{metrics}}"
    },
    {
      "wait": 40,
      "type": "run_ended",
      "data": {
        "status": "ok",
        "error": null
      }
    }
  ]
}
