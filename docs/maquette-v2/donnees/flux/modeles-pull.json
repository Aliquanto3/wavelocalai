{
  "id": "modeles-pull",
  "kind": "pull",
  "label": "Installation d'un modèle ou du reranker : préparation, téléchargement chiffré, vérification, installé",
  "_doc": "vars : tag, reranker (nom ou null), total_bytes, b1 à b10 (octets reçus aux dixièmes). Événement pull_progress {tag, reranker, received_bytes, total_bytes, phase: preparing | downloading | verifying}.",
  "events": [
    {
      "wait": 0,
      "type": "run_started",
      "data": {
        "kind": "pull",
        "tag": "{{tag}}",
        "reranker": "{{reranker}}"
      }
    },
    {
      "wait": 300,
      "type": "pull_progress",
      "data": {
        "tag": "{{tag}}",
        "reranker": "{{reranker}}",
        "received_bytes": 0,
        "total_bytes": "{{total_bytes}}",
        "phase": "preparing"
      }
    },
    {
      "wait": 600,
      "type": "pull_progress",
      "data": {
        "tag": "{{tag}}",
        "reranker": "{{reranker}}",
        "received_bytes": "{{b1}}",
        "total_bytes": "{{total_bytes}}",
        "phase": "downloading"
      }
    },
    {
      "wait": 600,
      "type": "pull_progress",
      "data": {
        "tag": "{{tag}}",
        "reranker": "{{reranker}}",
        "received_bytes": "{{b2}}",
        "total_bytes": "{{total_bytes}}",
        "phase": "downloading"
      }
    },
    {
      "wait": 600,
