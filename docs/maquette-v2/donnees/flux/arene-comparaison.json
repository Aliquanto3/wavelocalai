   }
  },
  {
   "wait": 250,
   "when": "{{s1}}",
   "type": "lane_status",
   "data": {
    "lane": "{{s1}}",
    "status": "{{s1_first}}"
   }
  },
  {
   "wait": 100,
   "when": "{{s1_loading}}",
   "type": "model_loading",
   "data": {
    "lane": "{{s1}}",
    "tag": "{{s1}}"
   }
  },
  {
   "wait": 3200,
   "slow_wait": 14000,
   "when": "{{s1_loading}}",
   "type": "model_loaded",
   "data": {
    "lane": "{{s1}}",
    "tag": "{{s1}}",
    "duration_s": "{{s1_load_s}}"
   }
  },
  {
   "wait": 80,
   "when": "{{s1_loading}}",
   "type": "lane_status",
   "data": {
    "lane": "{{s1}}",
    "status": "generating"
   }
  },
  {
   "wait": 300,
   "when": "{{s1_has_text}}",
   "tokens": {
    "lane": "{{s1}}",
    "channel": "answer",
    "text": "{{s1_text}}",
    "tps": "{{s1_tps}}"
   }
  },
  {
   "wait": 2200,
   "when": "{{s1_fail}}",
   "type": "lane_status",
   "data": {
    "lane": "{{s1}}",
    "status": "{{s1_fail_status}}",
    "error": "{{s1_error}}"
   }
  },
  {
   "wait": 120,
   "when": "{{s1_ok}}",
   "type": "metrics",
   "data": "{{s1_metrics}}"
  },
  {
   "wait": 80,
   "when": "{{s1_ok}}",
   "type": "lane_status",
   "data": {
    "lane": "{{s1}}",
    "status": "judging"
   }
  },
  {
   "wait": 1300,
   "when": "{{s1_ok}}",
   "type": "judge_score",
   "data": {
    "lane": "{{s1}}",
    "score": "{{s1_score}}",
    "reason": "{{s1_reason}}"
   }
  },
  {
   "wait": 60,
   "when": "{{s1_ok}}",
   "type": "lane_status",
   "data": {
    "lane": "{{s1}}",
    "status": "done"
   }
